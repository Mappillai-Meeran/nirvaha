# NIRVAHA Environment Configuration Example
# Copy this file to .env and configure values before starting the application.

# Server Configuration
PORT=8080
NIRVAHA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/nirvaha_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# Security & JWT Token Parameters
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG
JWT_EXPIRATION=86400000

# Rate Limiting Parameters (Requests per minute per IP)
NIRVAHA_RATE_LIMIT=60
NIRVAHA_RATE_LIMIT_WINDOW=60

# File Evidence Storage Configuration
NIRVAHA_MAX_EVIDENCE_SIZE=10MB
NIRVAHA_EVIDENCE_STORAGE_PATH=uploads/evidence
