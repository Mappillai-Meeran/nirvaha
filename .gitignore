# Nirvaha Root Git Ignore

# Environment files with sensitive credentials
.env
.env*.local
*.env
!*.env.example
application-local.properties
*local.properties

# Build outputs
target/
dist/
dist-ssr/
build/
bin/

# Dependency directories
node_modules/
.pnpm-store/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime uploaded evidence and user-generated files
uploads/
/uploads/
nirvaha-backend/uploads/
/nirvaha-backend/uploads/
/nirvaha-backend/uploads/evidence/

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary diagnostics & crash dumps
*.tmp
*.bak
*.swp
*~

# Temporary scratch scripts & manual test harnesses
/nirvaha-backend/src/test/*.ps1
nirvaha-backend/src/test/*.ps1

